# =============================================================================
# .env.example — COMMITTED template. Copy to `.env` (git-ignored) and fill in.
# Real secrets NEVER go in the repo (constitution §5). In prod, these come from
# Render's environment variables; the values below are local-dev placeholders.
# =============================================================================

# --- Spring profile -----------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# --- Database (prod: Neon) ----------------------------------------------------
# Two least-privilege roles (data-model.md §Least privilege):
#   migration role -> DDL (Flyway only)      app role -> DML (SELECT/INSERT + TTL DELETE)
DATABASE_URL=jdbc:postgresql://localhost:5432/currency_ledger
DATABASE_USERNAME=app
DATABASE_PASSWORD=change-me-app
DB_MIGRATION_USERNAME=migration
DB_MIGRATION_PASSWORD=change-me-migration
DB_POOL_SIZE=10

# --- Treasury Rates of Exchange API -------------------------------------------
# Public, unauthenticated — no key required. Overridable for WireMock in tests.
FX_RATES_TREASURY_BASE_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service

# --- Rate provider (D-03): passthrough | ondemand | ingest | hybrid -----------
FX_RATES_PROVIDER=ondemand
